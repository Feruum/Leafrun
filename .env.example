# Required. Generate a random value before starting Compose.
API_KEY=

API_PORT=8080
GITEA_PORT=3000
GITEA_PUBLIC_URL=http://localhost:3000/
GITEA_INTERNAL_URL=http://gitea:3000/

# Set both for private Gitea repositories. Use a reader account token.
GITEA_USERNAME=
GITEA_TOKEN=

GIT_ALLOWED_HOSTS=github.com,gitlab.com
REQUEST_TIMEOUT=60s
MAX_CONCURRENT=2
MAX_REQUEST_BYTES=1048576
MAX_PROJECT_BYTES=104857600
CACHE_TTL=24h
